# ---------- 服务 ----------
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=luotianyi
DB_PASSWORD=luotianyi
DB_DATABASE=luotianyi_wiki
# 生产环境请务必关闭，改用 migration
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ---------- JWT ----------
JWT_SECRET=luotianyi-dev-secret-change-me
JWT_EXPIRES_IN=7d

# ---------- Meilisearch ----------
MEILI_ENABLED=true
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=luotianyi_dev_master_key
MEILI_SONG_INDEX=songs

# ---------- 表情广场上传 ----------
# 相对路径基于后端进程工作目录（apps/api）；生产环境建议使用绝对路径或挂载卷
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=12
EMOJI_MAX_DIMENSION=1080
EMOJI_WEBP_QUALITY=82
EMOJI_SEARCH_MAX_DISTANCE=12

# ---------- 初始管理员（执行 pnpm seed 时写入） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=luotianyi2026
