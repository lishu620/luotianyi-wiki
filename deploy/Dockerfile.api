# syntax=docker/dockerfile:1
# ---------- 后端镜像（多阶段：容器内从源码构建）----------
# 构建上下文 = 仓库根目录（docker compose 中 context: ..）
#   ./
#   ├── package.json / pnpm-lock.yaml / pnpm-workspace.yaml
#   ├── packages/shared
#   └── apps/api

# ===================== 构建阶段 =====================
FROM node:22-alpine AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /src

# 先复制依赖清单，最大化利用层缓存
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @luotianyi/shared --filter @luotianyi/api

# 再复制源码并编译（shared 必须先于 api 构建）
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @luotianyi/shared build \
    && pnpm --filter @luotianyi/api build \
    && node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('apps/api/package.json','utf8'));p.dependencies['@luotianyi/shared']='file:./shared';fs.writeFileSync('/tmp/runtime-package.json',JSON.stringify({name:'luotianyi-api-runtime',version:p.version,private:true,main:'dist/main.js',dependencies:p.dependencies},null,2))"

# ===================== 运行阶段 =====================
FROM node:22-alpine

ENV NODE_ENV=production \
    TZ=Asia/Shanghai
WORKDIR /app

# 表情水印使用 SVG 文字渲染，需要中文字体（Alpine 默认无字体）
RUN apk add --no-cache font-noto-cjk

# 只装生产依赖；@luotianyi/shared 通过本地目录链接，无需发布到 npm
COPY --from=build /tmp/runtime-package.json ./package.json
COPY --from=build /src/packages/shared/dist ./shared/dist
COPY --from=build /src/packages/shared/package.json ./shared/package.json
RUN npm install --omit=dev --no-audit --no-fund --no-package-lock \
    && npm cache clean --force

# 编译产物（含 dist/main.js 与 dist/database/seed.js）
COPY --from=build /src/apps/api/dist ./dist

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||3000)+'/api/stats/overview').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
