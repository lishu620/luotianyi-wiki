# ---------- 生产环境变量（部署到服务器仓库的 deploy/.env）----------
# 请务必修改下面所有带 CHANGE_ME 的值

# 对外访问来源；* 表示回显请求来源（前端与 /api 同源，无需绑定具体 IP）
CORS_ORIGINS=*

# PostgreSQL
DB_USERNAME=luotianyi
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_DATABASE=luotianyi_wiki

# JWT（生成方式：openssl rand -base64 48）
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# 初始管理员（仅 seed 时使用；本部署通过导入 dump 复用本地账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 宿主机对外端口（默认 80 直接对外提供 HTTP 服务）
WEB_HOST_PORT=80
# 前端容器绑定地址：留空=0.0.0.0（全部网卡）。
# 宿主机已装 Nginx/Apache 占用 80 时，设为 127.0.0.1 并把宿主机 Nginx 反代到 127.0.0.1:<WEB_HOST_PORT>
WEB_BIND_IP=
